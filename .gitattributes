# Store text files with LF line endings and check them out with the platform's native ones.
# Forcing CRLF here made Dependabot commit CRLF blobs, which turned every update into a whole-file diff.
* text=auto

*.cs     diff=csharp
*.cshtml diff=html
*.csx    diff=csharp

# Scripts whose interpreter requires a specific line ending.
*.sh     text eol=lf
*.cmd    text eol=crlf
*.bat    text eol=crlf

# Generated bindings are written with LF on every OS (scripts/generate-bindings.cs); checking them out with LF too
# keeps a regeneration on Windows from showing line-ending changes.
*.g.cs   text eol=lf
