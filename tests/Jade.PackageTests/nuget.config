<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Jade and Jade.Native come only from the local feed, even when nuget.org has the same version. -->
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Jade" />
      <package pattern="Jade.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- NuGet never refreshes a version it has extracted, and every local pack of one commit carries the same version.
       A packages folder of its own, which scripts/test-package.cs clears of Jade before each run, keeps stale natives
       out of the test and local builds out of the global cache. -->
  <config>
    <add key="globalPackagesFolder" value="../../artifacts/package-tests/packages" />
  </config>

</configuration>
