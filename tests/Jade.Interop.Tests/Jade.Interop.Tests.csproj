<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jade.Interop\Jade.Interop.csproj" />
  </ItemGroup>

  <!-- jade_native as staged for this machine by scripts/build-native.cs or scripts/fetch-native.cs. Taking it from the
       Jade.Native package instead would mean packing before every test run; tests/Jade.PackageTests covers the
       package. Without a staged library, the tests that call it skip. -->
  <PropertyGroup>
    <JadeNativeStage>$(MSBuildThisFileDirectory)..\..\artifacts\native\$(NETCoreSdkRuntimeIdentifier)\</JadeNativeStage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(JadeNativeStage)lib\*jade_native*" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(JadeNativeStage)metadata\versions.json" Link="jade_native.versions.json" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('$(JadeNativeStage)metadata\versions.json')" />
  </ItemGroup>

</Project>
