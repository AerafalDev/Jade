root = true

# Line endings are left to git: LF in the repository, native on checkout (see .gitattributes).

[*]
charset = utf-8
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 180

[*.{md,mdx}]
max_line_length = off
trim_trailing_whitespace = false

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2
tab_width = 2

[*.{js,mjs,cjs,ts,mts,tsx,css}]
indent_size = 2
tab_width = 2

[*.{xml,csproj,props,targets,resx,config,slnx}]
indent_size = 2
tab_width = 2

[*.cs]
indent_size = 4
tab_width = 4

# .NET code style: ADR-0011, the dotnet/runtime coding style with house deviations. Each enforced rule is a
# warning, which EnforceCodeStyleInBuild and TreatWarningsAsErrors turn into a build error. Severities are set with
# dotnet_diagnostic rather than an option suffix because several rules share one option.

# Formatting (IDE0055): Allman braces and dotnet/runtime's indentation. Spacing options keep their defaults, which
# are dotnet/runtime's values.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = false
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false
dotnet_diagnostic.IDE0055.severity = warning

# Never two blank lines in a row (IDE2000, experimental).
dotnet_style_allow_multiple_blank_lines_experimental = false
dotnet_diagnostic.IDE2000.severity = warning

# Braces (IDE0011). Runtime rule 18 lets single-line bodies go without braces unless another block of the same
# if/else chain has them. when_multiline is the closest value: true forbids what the rule allows, false allows
# multi-line bodies without braces.
csharp_prefer_braces = when_multiline
dotnet_diagnostic.IDE0011.severity = warning
# Rule 18 also forbids the single-line form, `if (x) return;` (IDE2001, experimental).
csharp_style_allow_embedded_statements_on_same_line_experimental = false
dotnet_diagnostic.IDE2001.severity = warning

# using directives outside the namespace (IDE0065), System first, none unused (IDE0005, which only runs on build
# when the project generates its XML documentation file).
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0065.severity = warning
dotnet_diagnostic.IDE0005.severity = warning

# File-scoped namespaces (IDE0161).
csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = warning

# Explicit accessibility (IDE0040), first in dotnet/runtime's modifier order (IDE0036).
dotnet_style_require_accessibility_modifiers = for_non_interface_members
dotnet_diagnostic.IDE0040.severity = warning
csharp_preferred_modifier_order = public, private, protected, internal, file, static, extern, new, virtual, abstract, sealed, override, readonly, unsafe, required, volatile, async
dotnet_diagnostic.IDE0036.severity = warning

# readonly fields where possible (IDE0044).
dotnet_style_readonly_field = true
dotnet_diagnostic.IDE0044.severity = warning

# var wherever possible (IDE0007), the house deviation from runtime rule 10.
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = none

# No this. (IDE0003) and keywords over BCL type names (IDE0049). Roslyn never runs these two on build
# (EnforceOnBuild.Never); `dotnet format --verify-no-changes` in CI reports them instead.
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false
dotnet_diagnostic.IDE0003.severity = warning
dotnet_diagnostic.IDE0009.severity = none
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true
dotnet_diagnostic.IDE0049.severity = warning

# Internal and private types are sealed (CA1852). AnalysisMode Recommended already enables it; ADR-0011 relies on it.
dotnet_diagnostic.CA1852.severity = warning

# Naming (IDE1006). Roslyn applies the most specific matching rule whatever the order here: const beats static,
# which beats the plain field rules. Naming symbols cannot select [ThreadStatic], so t_ fields are not checked
# and a thread-static field needs a justified IDE1006 suppression.
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.s_camel_case.capitalization = camel_case
dotnet_naming_style.s_camel_case.required_prefix = s_
dotnet_naming_style.i_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_pascal_case.required_prefix = I
dotnet_naming_style.t_pascal_case.capitalization = pascal_case
dotnet_naming_style.t_pascal_case.required_prefix = T

dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_rule.constant_fields_are_pascal_case.symbols = constant_fields
dotnet_naming_rule.constant_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.constant_fields_are_pascal_case.severity = warning

dotnet_naming_symbols.constant_locals.applicable_kinds = local
dotnet_naming_symbols.constant_locals.applicable_accessibilities = local
dotnet_naming_symbols.constant_locals.required_modifiers = const
dotnet_naming_rule.constant_locals_are_pascal_case.symbols = constant_locals
dotnet_naming_rule.constant_locals_are_pascal_case.style = pascal_case
dotnet_naming_rule.constant_locals_are_pascal_case.severity = warning

dotnet_naming_symbols.non_public_static_fields.applicable_kinds = field
dotnet_naming_symbols.non_public_static_fields.applicable_accessibilities = private, internal, private_protected
dotnet_naming_symbols.non_public_static_fields.required_modifiers = static
dotnet_naming_rule.non_public_static_fields_are_s_camel_case.symbols = non_public_static_fields
dotnet_naming_rule.non_public_static_fields_are_s_camel_case.style = s_camel_case
dotnet_naming_rule.non_public_static_fields_are_s_camel_case.severity = warning

dotnet_naming_symbols.non_public_fields.applicable_kinds = field
dotnet_naming_symbols.non_public_fields.applicable_accessibilities = private, internal, private_protected
dotnet_naming_rule.non_public_fields_are_underscore_camel_case.symbols = non_public_fields
dotnet_naming_rule.non_public_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.non_public_fields_are_underscore_camel_case.severity = warning

dotnet_naming_symbols.visible_fields.applicable_kinds = field
dotnet_naming_symbols.visible_fields.applicable_accessibilities = public, protected, protected_internal
dotnet_naming_rule.visible_fields_are_pascal_case.symbols = visible_fields
dotnet_naming_rule.visible_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.visible_fields_are_pascal_case.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_rule.interfaces_are_i_pascal_case.symbols = interfaces
dotnet_naming_rule.interfaces_are_i_pascal_case.style = i_pascal_case
dotnet_naming_rule.interfaces_are_i_pascal_case.severity = warning

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.type_parameters.applicable_accessibilities = *
dotnet_naming_rule.type_parameters_are_t_pascal_case.symbols = type_parameters
dotnet_naming_rule.type_parameters_are_t_pascal_case.style = t_pascal_case
dotnet_naming_rule.type_parameters_are_t_pascal_case.severity = warning

dotnet_naming_symbols.types_and_members.applicable_kinds = namespace, class, struct, enum, delegate, method, local_function, property, event
dotnet_naming_symbols.types_and_members.applicable_accessibilities = *
dotnet_naming_rule.types_and_members_are_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_and_members_are_pascal_case.style = pascal_case
dotnet_naming_rule.types_and_members_are_pascal_case.severity = warning

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_symbols.parameters_and_locals.applicable_accessibilities = *
dotnet_naming_rule.parameters_and_locals_are_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_are_camel_case.style = camel_case
dotnet_naming_rule.parameters_and_locals_are_camel_case.severity = warning

# Preferences outside ADR-0011, not enforced.
csharp_style_prefer_utf8_string_literals = true:suggestion
dotnet_style_parentheses_in_arithmetic_binary_operators = never_if_unnecessary:none
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:none
dotnet_style_parentheses_in_relational_binary_operators = never_if_unnecessary:none

# ReSharper / Rider formatting
resharper_autodetect_indent_settings = true
resharper_blank_lines_after_control_transfer_statements = 1
resharper_blank_lines_after_multiline_statements = 1
resharper_blank_lines_around_block_case_section = 1
resharper_blank_lines_around_multiline_case_section = 1
resharper_blank_lines_around_single_line_local_method = 1
resharper_blank_lines_before_block_statements = 1
resharper_blank_lines_before_control_transfer_statements = 1
resharper_blank_lines_before_multiline_statements = 1
resharper_braces_redundant = true
resharper_builtin_type_apply_to_native_integer = true
resharper_csharp_keep_blank_lines_in_declarations = 1
resharper_default_value_when_type_evident = default_expression
resharper_default_value_when_type_not_evident = default_expression
resharper_empty_string = string_empty
resharper_formatter_off_tag = @formatter:off
resharper_formatter_on_tag = @formatter:on
resharper_formatter_tags_enabled = true
resharper_new_line_before_while = true
resharper_object_creation_when_type_evident = explicitly_typed
resharper_place_accessorholder_attribute_on_same_line = false
resharper_place_accessor_attribute_on_same_line = false
resharper_place_expr_method_on_single_line = false
resharper_place_expr_property_on_single_line = false
resharper_place_field_attribute_on_same_line = false
resharper_place_simple_embedded_statement_on_same_line = false
resharper_show_autodetect_configure_formatting_tip = false
resharper_use_indent_from_vs = false
resharper_wrap_after_property_in_chained_method_calls = true
resharper_wrap_array_initializer_style = chop_always
resharper_wrap_before_first_method_call = true

# ReSharper / Rider inspection severities
resharper_arrange_redundant_parentheses_highlighting = hint
resharper_arrange_this_qualifier_highlighting = hint
resharper_arrange_type_member_modifiers_highlighting = hint
resharper_arrange_type_modifiers_highlighting = hint
resharper_built_in_type_reference_style_for_member_access_highlighting = hint
resharper_built_in_type_reference_style_highlighting = hint
resharper_redundant_base_qualifier_highlighting = warning
resharper_suggest_var_or_type_built_in_types_highlighting = hint
resharper_suggest_var_or_type_elsewhere_highlighting = hint
resharper_suggest_var_or_type_simple_types_highlighting = hint

# Test projects: xunit naming conventions use underscores. Test classes are public for xunit but are not API, and
# only libraries need XML docs; tests generate the documentation file solely so that IDE0005 runs on build.
[tests/*.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CS1591.severity = none

# Generated bindings are public API (ADR-0006) and generated layout tests are repository code: ADR-0011 covers
# both, so the generator must emit conforming code. Without this, Roslyn exempts *.g.cs files by name, and so does
# dotnet format unless it gets --include-generated.
[{src/Jade.Interop,tests/Jade.Interop.Tests}/Generated/**.cs]
generated_code = false

# Rules the bindings break on purpose under ADR-0006: every C function is a public 1:1 import (CA1401), enums keep
# C's aliased constants (CA1069), and types keep their C names, such as SDL_InitFlags and SDL_Event (CA1711, CA1716).
[src/Jade.Interop/Generated/**.cs]
dotnet_diagnostic.CA1401.severity = none
dotnet_diagnostic.CA1069.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1716.severity = none

#### Repository-specific ####

[*.cs]
# Explicit constructors only, never C# primary constructors.
csharp_style_prefer_primary_constructors = false
dotnet_diagnostic.IDE0290.severity = none
